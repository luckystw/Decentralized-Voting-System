{
  "name": "decentralized-voting-system",
  "version": "1.0.0",
  "description": "A blockchain-based decentralized voting system with enhanced security and transparency",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install",
    "compile-contracts": "npx hardhat compile",
    "deploy-contracts": "npx hardhat run scripts/deploy.js --network localhost"
  },
  "keywords": [
    "blockchain",
    "voting",
    "decentralized",
    "ethereum",
    "smart-contracts",
    "web3"
  ],
  "author": "Decentralized Voting System Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "web3": "^4.2.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.3.0",
    "concurrently": "^8.2.2",
    "hardhat": "^2.19.1",
    "nodemon": "^3.0.2"
  }
}
